# Vercel Postgres (Storage -> Create Database -> Postgres) — переменные подставляются
# автоматически при подключении БД к проекту в Vercel, но для локальной разработки
# скопируйте их из Vercel Dashboard -> Storage -> ваша БД -> .env.local
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# Vercel Blob (Storage -> Create -> Blob) — токен тоже подставляется автоматически
BLOB_READ_WRITE_TOKEN=

# Своя авторизация
JWT_SECRET=замените-на-длинную-случайную-строку

# Telegram-бот (@BotFather)
TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_BOT_USERNAME=your_bot_username

# Секрет для защиты /api/cron/weekly-report (Vercel подставляет его сам в заголовок при вызове по cron)
CRON_SECRET=замените-на-случайную-строку
